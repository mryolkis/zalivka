# Apple DFU/recovery and restore interfaces. Access for the active local seat.
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", TAG+="uaccess"

# Zalivka owns DFU, Recovery, Port DFU and KIS. Restored (12ac) uses system usbmuxd.
# Keep direct boot interfaces accessible without changing restored's daemon policy.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="1227|128[0-3]|f014|1881", ENV{USBMUX_SUPPORTED}="0", ENV{SYSTEMD_WANTS}="", OWNER:="root", GROUP:="root", MODE:="0600"
